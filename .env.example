APP_NAME=Maragheh
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.maraghehcity.ir
APP_TIMEZONE=Asia/Tehran

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel MySQL (database + user created in "MySQL Databases")
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_maragheh
DB_USERNAME=cpaneluser_maragheh
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Admin panel origin (CORS)
ADMIN_URL=https://admin.maraghehcity.ir

# Kavenegar OTP (https://panel.kavenegar.com -> API key + a "verify lookup" template with %token)
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=maragheh-otp

# OTP behaviour
OTP_LENGTH=5
OTP_TTL_SECONDS=180
OTP_RESEND_SECONDS=120

# Weather (Open-Meteo, no key needed) — Maragheh coordinates
WEATHER_LAT=37.3917
WEATHER_LON=46.2392
WEATHER_CACHE_MINUTES=30

# News crawler
CRAWLER_USER_AGENT="Mozilla/5.0 (compatible; MaraghehCityBot/1.0; +https://maraghehcity.ir)"
CRAWLER_MAX_ARTICLES_PER_RUN=40
# true = store the full article text; false = store only title/summary/image and link to the source
NEWS_STORE_FULL_BODY=true
